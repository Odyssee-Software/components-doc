{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react",
    "jsxFactory": "Pulse.jsx",
    "jsxFragmentFactory": "Pulse.Fragment",
    "types": ["node"]
  },
  "include": [
    "node_modules/@odyssee-software/pulse-framework/dist/**/*",
    "node_modules/@odyssee-software/components/dist/**/*"
  ],
  "exclude": [
    "node_modules/@odyssee-software/*/node_modules",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
